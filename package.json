{
  "name": "server",
  "version": "1.0.0",
  "description": "eco-collectors API (Express + MariaDB)",
  "main": "server.js",
  "scripts": {
    "start": "node server",
    "dev": "nodemon server",
    "test": "node --test --test-concurrency=1 --test-timeout=60000 \"test/*.test.js\"",
    "test:db:start": "docker run -d --rm --name eco-test-db -e MARIADB_ROOT_PASSWORD=eco-test -p 127.0.0.1:3307:3306 mariadb:11.4.13 --character-set-server=utf8mb4 --collation-server=utf8mb4_bin --skip-name-resolve",
    "test:db:stop": "docker stop eco-test-db"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.4",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2"
  },
  "engines": {
    "node": ">=20"
  }
}
